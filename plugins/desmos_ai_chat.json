{
  "id": "desmos-ai-chat",
  "name": "Desmos Chat Assistant",
  "type": "plugin",
  "configSchema": [
    {
      "id": "apiEndpoint",
      "label": "API Endpoint (base URL)",
      "type": "text",
      "default": "http://localhost:8000"
    },
    {
      "id": "modelName",
      "label": "Model Name",
      "type": "text",
      "default": "openai/claude-opus-4-6"
    }
  ],
  "contentScripts": [
    {
      "matches": [
        "https://www.desmos.com/calculator*"
      ]
    }
  ]
}
