{
  "id": "task-notifier",
  "name": "Task Availability Notifier",
  "type": "plugin",
  "configSchema": [
    {
      "id": "enabled",
      "type": "toggle",
      "label": "Enable periodic checks",
      "default": false
    },
    {
      "id": "period",
      "type": "number",
      "label": "Period (min, minimum 0.17)",
      "min": 0.17,
      "step": 0.01,
      "default": 10
    },
    {
      "id": "audioUrl",
      "type": "text",
      "label": "Sound URL (HTTPS)",
      "default": "https://actions.google.com/sounds/v1/alarms/beep_short.ogg"
    }
  ],
  "contentScripts": [
    {
      "matches": [
        "https://app.outlier.ai/*"
      ]
    }
  ],
  "commandNames": [
    "toggle_notifications"
  ]
}
