{
    "manifest_version": 3,
    "name": "Audit Tools",
    "version": "4.0.0",
    "description": "Tools for auditors (Scale QC team) - Plugin based",
    "permissions": ["scripting", "storage", "activeTab", "cookies", "tabs"],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "manager.html",
    "commands": {
	"open_command_palette": {
	    "suggested_key": { "default": "Alt+P" },
	    "description": "Open command palette"
	},
        "kb_command_1": {
            "description": "Configurable Keyboard Shortcut 1"
        },
        "kb_command_2": {
            "description": "Configurable Keyboard Shortcut 2"
        },
        "kb_command_3": {
            "description": "Configurable Keyboard Shortcut 3"
        }
    },
    "host_permissions": ["<all_urls>"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    }
}
