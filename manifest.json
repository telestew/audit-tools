{
    "manifest_version": 3,
    "name": "Audit Tools",
    "version": "4.0.0",
    "description": "Tools for auditors (Scale QC team) - Plugin based",
    "permissions": ["scripting", "storage", "activeTab", "cookies", "tabs"],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "manager.html",
    "commands": {
	"open_command_palette": {
	    "suggested_key": { "default": "Alt+P" },
	    "description": "Open command palette"
	},
        "lookup_task": {
            "suggested_key": {
                "default": "Alt+L"
            },
            "description": "Looks up task in Outlier by ID"
        },
        "lookup_project": {
            "suggested_key": {
                "default": "Alt+K"
            },
            "description": "Looks up project in OpsHub by ID"
        },
        "create_operation_from_clipboard": {
            "suggested_key": {
                "default": "Alt+O"
            },
            "description": "Creates batch operation from clipboard IDs" 
        }
    },
    "host_permissions": ["<all_urls>"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    }
}
